+# --------------------------------------------------------------------------- kept on disk, across updates
+ENGINE_FILES = 4            # per-career files kept (the newest: a career or two, and the one before the latest match)
+_engine_dirty: dict[str, object] = {}
+
+
+def career_print(career) -> str:
+    """A career's fingerprint without the site's version: its exact scorecards, its Data check choices, its matches as
+    the site sees them (home and away from your schedule included) and whether fielding counts."""
+    sig = (id(career.matches), len(career.matches))
+    got = getattr(career, "_engine_print", None)
+    if got and got[0] == sig:
+        return got[1]
+    import pandas as pd
+    h = hashlib.sha1()
+    for source in sorted(career.texts):
+        h.update(source.encode())
+        t = career.texts[source]
+        h.update(t.encode() if isinstance(t, str) else bytes(t))
+    h.update(career.fixes.to_json().encode())
+    # the tables exactly as read (so an update to how scorecards are read can never leave a sum out of date)
+    for name in ("matches", "innings", "batting", "bowling", "fow", "fielding"):
+        t = getattr(career, name, None)
+        if isinstance(t, pd.DataFrame):
+            h.update(name.encode() + repr(list(t.columns)).encode() + repr(list(map(str, t.dtypes))).encode())
+            if len(t):
+                h.update(pd.util.hash_pandas_object(t.astype(str), index=False).to_numpy().tobytes())
+    h.update(repr(getattr(career, "count_fielding", None)).encode())
+    fp = h.hexdigest()[:20]
+    try:
+        object.__setattr__(career, "_engine_print", (sig, fp))
+    except Exception:   # noqa: BLE001
+        pass
+    return fp
+
+
+def _engine_store(career) -> dict | None:
+    """The career's sums kept on disk ({(code version, key): value}), read the first time."""
+    if not DIR:
+        return None
+    fp = career_print(career)
+    got = getattr(career, "_engine_disk", None)
+    if got and got[0] == fp:
+        return got[1]
+    values: dict = {}
+    f = DIR / f"engine-{fp}.pickle"
+    if f.is_file():
+        try:
+            with open(f, "rb") as fh:
+                values = pickle.load(fh)
+        except Exception:   # noqa: BLE001 - a damaged or half-written file: worked out again
+            values = {}
+    try:
+        object.__setattr__(career, "_engine_disk", (fp, values))
+    except Exception:   # noqa: BLE001
+        return None
+    return values
+
+
+def on_disk(career, key, make, code: tuple[str, ...]):
+    """`make()` worked out once per career and kept on disk, so it survives restarts and updates: stamped with the
+    career's exact scorecards (career_print) and only the code it's worked out with (`code`: the engine modules,
+    version_of). An update that changes any of that code works it out afresh, so it is never out of date."""
+    code = tuple(sorted(code))
+    v = version_of(*code)
+    full = (code, v) + tuple(key)
+    def make_kept():
+        store = _engine_store(career)
+        if store is not None and full in store:
+            return store[full]
+        value = make()
+        if store is not None:
+            with _lock:
+                store[full] = value
+                _engine_dirty[career_print(career)] = career
+        return value
+    return on_career(career, ("disk",) + full, make_kept)
+
+
+def _save_engine() -> None:
+    with _lock:
+        todo = list(_engine_dirty.items())
+        _engine_dirty.clear()
+    for fp, career in todo:
+        got = getattr(career, "_engine_disk", None)
+        if not got or got[0] != fp:
+            continue
+        with _lock:
+            values = dict(got[1])
+        # sums worked out with code that has since changed are never read again: left out
+        values = {k: x for k, x in values.items() if version_of(*k[0]) == k[1]}
+        f = DIR / f"engine-{fp}.pickle"
+        tmp = f.with_suffix(f".{os.getpid()}.{threading.get_ident()}.tmp")
+        try:
+            with open(tmp, "wb") as fh:
+                pickle.dump(values, fh, protocol=pickle.HIGHEST_PROTOCOL)
+            os.replace(tmp, f)
+        except Exception:   # noqa: BLE001 - a full disk: worked out again next time
+            continue
+    old = sorted(DIR.glob("engine-*.pickle"), key=lambda p: p.stat().st_mtime, reverse=True)[ENGINE_FILES:]
+    for p in old:
+        try:
+            p.unlink()
+        except OSError:
+            pass
+
+
 def on_career(career, key, make):
     """`make()` worked out once per career in memory (kept until its matches change): for a sum several pages ask for
     with the same matches."""
