+
+
+# ---------------------------------------------------------------- the heavy sums kept on disk across updates
+def _heavy(c):
+    from ccstats import extras as E
+    from ccstats import hall as H
+    from ccstats import marks as M
+    from ccstats import ranking as R
+    sec = c.matches.section.iloc[0]
+    return dict(honours=E.honours(c), marks=M.series_marks(c), states=R.states(c),
+                inductions=H.inductions(c, sec))
+
+
+def _same(a, b):
+    for k in a:
+        if isinstance(a[k], pd.DataFrame):
+            pd.testing.assert_frame_equal(a[k], b[k])
+        else:
+            assert repr(a[k]) == repr(b[k]), k
+
+
+def test_heavy_sums_survive_a_restart_and_an_unrelated_update_with_the_same_numbers(kept_dir, monkeypatch):
+    first = _heavy(build(FIXTURES))
+    KEEP.save()
+    assert len(list(kept_dir.glob("engine-*.pickle"))) == 1
+    # a restart after an update to code these sums don't use: read back, nothing worked out again
+    KEEP.reset()
+    import ccstats.extras as E
+    monkeypatch.setattr(E, "_honours", lambda c: (_ for _ in ()).throw(AssertionError("worked out again")))
+    again = _heavy(build(FIXTURES))
+    _same(first, again)
+
+
+def test_heavy_sums_are_worked_out_afresh_when_their_own_code_changes(kept_dir, monkeypatch):
+    _heavy(build(FIXTURES))
+    KEEP.save()
+    KEEP.reset()
+    real = KEEP.version_of
+    # the honours code (extras.py) "changed": its saved answer is never used
+    monkeypatch.setattr(KEEP, "version_of", lambda *m: "changed" if "extras" in m else real(*m))
+    import ccstats.extras as E
+    calls = []
+    orig = E._honours
+    monkeypatch.setattr(E, "_honours", lambda c: calls.append(1) or orig(c))
+    _heavy(build(FIXTURES))
+    assert calls == [1]
+    # and saving leaves out what the old code worked out
+    KEEP.save()
+    import pickle
+    (f,) = kept_dir.glob("engine-*.pickle")
+    keys = pickle.loads(f.read_bytes()).keys()
+    assert all(KEEP.version_of(*k[0]) == k[1] for k in keys)
+
+
+def test_heavy_sums_are_never_shared_between_different_scorecards(kept_dir):
+    a = build(FIXTURES)
+    _heavy(a)
+    KEEP.save()
+    KEEP.reset()
+    b = build(FIXTURES[:-1])
+    assert KEEP.career_print(a) != KEEP.career_print(b)
+    from ccstats import extras as E
+    fresh = E._honours(b)
+    pd.testing.assert_frame_equal(E.honours(b), fresh)
+
+
+def test_a_version_covers_every_engine_module_it_uses():
+    # ranking.py uses other engine modules; a change in any of them is a change of version for ranking's sums
+    used = set()
+    todo = ["ranking"]
+    while todo:
+        m = todo.pop()
+        if m not in used:
+            used.add(m)
+            todo += list(KEEP._imports(m))
+    assert len(used) > 1
