     return _version
 
 
+_scoped: dict[str, str] = {}
+_vlock = threading.Lock()   # its own lock: version_of is asked while _lock is held (memo reading its file)
+
+
+def _imports(name: str) -> set[str]:
+    """The engine modules one engine module uses (its `from .x import`, `from . import x` and `from .x.y` lines)."""
+    import re
+    f = Path(__file__).resolve().parent / f"{name}.py"
+    try:
+        text = f.read_text(encoding="utf-8")
+    except OSError:
+        return set()
+    out = set(re.findall(r"^\s*from \.(\w+)", text, re.M))
+    for group in re.findall(r"^\s*from \. import ([\w ,()]+)", text, re.M):
+        out |= {w.split(" as ")[0].strip() for w in group.replace("(", "").replace(")", "").split(",") if w.strip()}
+    return {x for x in out if (f.parent / f"{x}.py").is_file()}
+
+
+def version_of(*modules: str) -> str:
+    """A fingerprint of just the code an answer is worked out with: the engine modules named, every engine module they
+    use (all the way down), the Python and pandas and numpy versions. An update that doesn't touch any of them keeps
+    the answers (an update that does is worked out afresh, so nothing can be out of date)."""
+    key = "|".join(sorted(modules))
+    with _vlock:
+        if key in _scoped:
+            return _scoped[key]
+    import sys
+    import numpy as np
+    import pandas as pd
+    seen: set[str] = set()
+    todo = list(modules)
+    while todo:
+        m = todo.pop()
+        if m in seen:
+            continue
+        seen.add(m)
+        todo += sorted(_imports(m) - seen)
+    root = Path(__file__).resolve().parent
+    h = hashlib.sha1(f"{sys.version_info[:2]}|{pd.__version__}|{np.__version__}".encode())
+    for m in sorted(seen):
+        f = root / f"{m}.py"
+        h.update(m.encode())
+        if f.is_file():
+            h.update(f.read_bytes())
+    v = h.hexdigest()[:12]
+    with _vlock:
+        _scoped[key] = v
+    return v
+
+
+# what each kind of kept answer is worked out with (its file is stamped with that code only)
+MEMO_CODE = {"parsed": ("loader",), "stands": ("partnerships",)}
+
+
